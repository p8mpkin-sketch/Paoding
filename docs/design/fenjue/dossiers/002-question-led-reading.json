{
 "dossier": "002",
 "name": "question-led-reading",
 "title": "方案分析引擎第 2 版：按题目读仓库作答（自指）",
 "status": "design_approved",
 "identified": "2026-11-25",
 "generated": true,
 "shihuo": {
  "source": "一个通用编码智能体在同一道题上的五次只读运行（行为序列与报告结构，docs/design/fenjue/materials/agent-baseline/）。只借做法，不调用它，不依赖它用的模型。",
  "phenomenon": "它先读题面点名的模块，整文件读，读完一批再顺着定义、用法、测试追下一批，中途回头读我们自己的对应实现；交付直接回答题面的问题，每个结论指到文件与行，拿不准的单列，出稿后回头核对。",
  "gap": "第 1 版按类别的词面线索取片段读，题面不参与选读哪里；同一道题五次运行里，题面点名的“上下文压缩”因已登记在案每次都被放进不提名，“会话持久化”一次没读到，交付里没有对题面两问的回答，也没有带行号的出处。",
  "is_fire": "是：一种可迁移的做法（按问题领读、追读、凭细事实作答、回头核对），与具体仓库和具体模型无关。"
 },
 "cuiyi": {
  "yi": "题面里点名的问题决定读哪里：把问题换成对方仓库里真实存在的名字，先整文件读命中的核心模块，读完一批再按“定义、用法、测试”排下一批；阅读交回带行区间的细事实，回答只许引用细事实，文件与行由程序推出；出稿后由另一个隔离的调用对着原文逐条核对，标注取核对结果。",
  "premise": "题面里有问句（怎么、如何、怎样）；材料是代码或文档形态；阅读的模型能在一次调用里读约三百行并交回结构化的事实。",
  "cost": "同一道题的调用数与 token 上升（上限按五次运行中位数的 1.5 倍：85 次、约 59 万 token）；多了七份提示词与三个引擎模块要维护；并发调用对端点限流更敏感（并发数做成配置项，缺省 4）。",
  "overlap": "通用勘察（按类别取片段）仍在：题面没有点名时照旧只走它；点名时缩成每个类别至多一段，用来保住题面之外的候选。识别候选、提炼、归位三步的隔离规则与检验不变。",
  "conflict": "“观察不带对方名字”的隔离规则与“回答要说得出名字和数值”相冲。解法：细事实与观察分成两套，细事实只给答题与核对两步看，留在工作区，不登记成产物；观察照旧不带名字，照旧走原有检验。",
  "hypothesis": "按题读之后：同一道题多次运行都能答出题面的每一问并给出集成建议；带行号的引用零越界且多数落在题面点名的模块；点名主题不再因已登记被剔除；未核对的结论不超过两成；用量在上限之内。",
  "split": "不放宽任何一条现有检验：观察的形状、候选清单的十二条检验、提炼与归位的检验都原样执行。新增的检查只加不减（细事实的行区间必须落在读过的范围内、不许照抄原文、回答不许自己写行号、挑的名字必须逐字在对方仓库里）。",
  "masked": "成立：这套读法不依赖出处是谁，换任何一个按问题读代码的人或工具都是这个次序。"
 },
