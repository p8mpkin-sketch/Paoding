{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "placement.schema.json",
 "title": "入位方案：入位的产出（08 §5.5），与 paoding_fenjue.lianhua.ruwei() 的入参一一对应",
 "type": "object",
 "required": ["v", "candidate", "atoms", "fire", "group", "replaces", "arms", "readings", "conflicts", "steps", "kernel_forecast", "split", "difficulty", "checks", "plain_summary"],
 "additionalProperties": false,
 "properties": {
  "v": { "const": 1 },
  "candidate": { "$ref": "common.schema.json#/$defs/candId" },
  "atoms": {
   "type": "array", "minItems": 1,
   "description": "位丹拆出的决策原子与确定性归位结果（08 §5.1–§5.2）",
   "items": { "type": "object", "required": ["atom", "home", "mechanism_steps"], "additionalProperties": false,
    "properties": {
     "atom": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$|^other$" },
     "home": { "type": "string", "pattern": "^(H[1-8]|T[1-5]|none)$" },
     "mechanism_steps": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
     "params": { "type": "object" },
     "owner_now": { "$ref": "common.schema.json#/$defs/fireRef", "description": "今天拥有这个原子的火（原子归属表）" },
     "why_other": { "type": "string", "maxLength": 300 } } }
  },
  "fire": { "$ref": "#/$defs/fireDraft" },
  "group": { "type": "array", "items": { "$ref": "#/$defs/fireDraft" }, "description": "火组的其余成员（行为有变的兼及火位，每个一团火）" },
  "replaces": { "oneOf": [{ "$ref": "common.schema.json#/$defs/fireId" }, { "type": "null" }] },
  "arms": {
   "type": "object",
   "required": ["B", "A1", "F", "B1"],
   "additionalProperties": false,
   "properties": {
    "B": { "type": "string" }, "A1": { "type": "string", "description": "照搬的最小接线设计；做不出写 infeasible: 理由（结局上限合炼，FJ8）" },
    "F": { "type": "string" }, "B1": { "type": "string" }, "A0": { "type": "string" }
   }
  },
  "readings": {
   "type": "array", "minItems": 1,
   "description": "预登记读数：与 lianhua.ruwei() 的 readings 同形（dim、kind、dir、gate、test），多出的键导入时存进 engine.placement",
   "items": { "type": "object", "required": ["dim", "kind", "dir"], "additionalProperties": false,
    "properties": {
     "dim": { "type": "string" }, "kind": { "enum": ["共有", "本火", "异火", "新生"] }, "dir": { "enum": ["up", "down"] },
     "gate": {}, "test": { "type": "string", "description": "结构读数的测试名（实现线写）" }, "run": { "type": "string", "description": "运行读数怎么跑" },
     "mandatory": { "type": "boolean", "description": "该火位必登的本火维" } } }
  },
  "conflicts": {
   "type": "object",
   "required": ["fires", "kernel", "candidates", "slot_locks"],
   "additionalProperties": false,
   "properties": {
    "fires": { "type": "array", "items": { "type": "object", "required": ["fire", "atom", "kind", "resolution"], "additionalProperties": false,
      "properties": { "fire": { "$ref": "common.schema.json#/$defs/fireRef" }, "atom": { "type": "string" }, "kind": { "enum": ["none", "parametric", "semantic"] }, "resolution": { "enum": ["coexist", "param", "partition", "replace", "reject"] }, "partition_by": { "type": "string", "description": "分区条件：开题时确定并写进事件的量（例：道）" }, "note": { "type": "string" } } } },
    "kernel": { "type": "array", "items": { "type": "object", "required": ["kernel", "resolution"], "additionalProperties": false, "properties": { "kernel": { "$ref": "common.schema.json#/$defs/kernelItem" }, "resolution": { "enum": ["fused_away", "split_to_kernel"] }, "note": { "type": "string" } } } },
    "candidates": { "type": "array", "items": { "type": "object", "required": ["other", "relation"], "additionalProperties": false, "properties": { "other": { "type": "string", "description": "候选编号或异火榜条目" }, "relation": { "enum": ["compatible", "sequential", "depends_on", "exclusive"] }, "note": { "type": "string" } } } },
    "slot_locks": { "type": "array", "items": { "type": "object", "required": ["slot", "dossier"], "additionalProperties": false, "properties": { "slot": { "$ref": "common.schema.json#/$defs/slot" }, "dossier": { "$ref": "common.schema.json#/$defs/dossierNo" } } } }
   }
  },
  "steps": {
   "type": "array", "minItems": 1,
   "description": "实现步骤清单：给人或实现线看，不是代码",
   "items": { "type": "object", "required": ["n", "do", "slot", "where", "tests", "kernel_lines", "accept"], "additionalProperties": false,
    "properties": {
     "n": { "type": "integer", "minimum": 1 }, "do": { "$ref": "common.schema.json#/$defs/shortText" },
     "slot": { "type": "string", "pattern": "^(H[1-8]|meter)$" },
     "where": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "组件与文件区，到目录或文件，不写代码" },
     "tests": { "type": "array", "items": { "type": "string" } },
     "kernel_lines": { "const": 0 },
     "accept": { "$ref": "common.schema.json#/$defs/shortText" } } }
  },
  "kernel_forecast": { "type": "array", "maxItems": 0, "description": "体质影响预判：实现步骤的文件区 ∩ KERNEL_PATHS，必须为空" },
  "split": { "type": "array", "items": { "type": "object", "required": ["part", "kernel", "to"], "properties": { "part": { "type": "string" }, "kernel": { "$ref": "common.schema.json#/$defs/kernelItem" }, "to": { "type": "string" } }, "additionalProperties": false } },
  "new_slot": {
   "type": ["object", "null"],
   "additionalProperties": false,
   "properties": { "name": { "type": "string" }, "decides": { "type": "string" }, "why_not_existing": { "type": "string" }, "ports": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/port" } }, "scattered_in": { "type": "array", "items": { "type": "string" } } }
  },
  "difficulty": { "type": "object", "required": ["value", "parts"], "additionalProperties": false, "properties": { "value": { "type": "integer", "minimum": 1, "maximum": 5 }, "parts": { "type": "object", "additionalProperties": { "type": "integer" } } } },
  "checks": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/checkResult" } },
  "plain_summary": { "$ref": "common.schema.json#/$defs/plainSummary" }
 },
 "$defs": {
  "fireDraft": {
   "type": "object",
   "description": "01 §8 的 Fire 形状，FIRE_KEYS 齐全；lineage.dossier 导入时填",
   "required": ["id", "ver", "slot", "ports", "params", "assets", "organ", "lineage", "switch"],
   "additionalProperties": false,
   "properties": {
    "id": { "$ref": "common.schema.json#/$defs/fireId" },
    "ver": { "type": "integer", "minimum": 1 },
    "slot": { "$ref": "common.schema.json#/$defs/slot" },
    "seats": { "type": "array", "items": { "enum": ["bootstrap", "reason", "explore", "solve", "verify", "recall", "idler"] } },
    "also_touches": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slot" } },
    "ports": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/port" } },
    "params": { "type": "object", "description": "不含任何预算绝对值或密钥（V8）" },
    "assets": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "sha256": { "type": "string" } }, "additionalProperties": false } },
    "organ": { "type": "object", "required": ["class", "enable_when", "control_arm"], "additionalProperties": false,
     "properties": { "class": { "enum": ["感知官", "量具"] }, "retire_signal": { "type": "string" }, "enable_when": { "type": "string" }, "control_arm": { "type": "string" } } },
    "lineage": { "type": "object", "required": ["from"], "additionalProperties": false,
     "properties": { "dossier": { "type": ["string", "null"] }, "from": { "type": "array", "items": { "type": "string" } }, "design": { "type": "string" } } },
    "switch": { "type": "string" }
   }
  }
 }
}
